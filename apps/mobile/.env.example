# Public values only; never put CLERK_SECRET_KEY in the mobile environment.

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZGl2aW5lLWdyYWNrbGUtNjA2MS5jbGVyay5hY2NvdW50cy5kZXYk

# Laravel API base URL, including /api. Restart Expo after editing .env.local.
# Physical device: use an HTTPS tunnel or your computer's reachable LAN address.
# Android emulator: http://10.0.2.2:8000/api (development only).
# Web on this computer: http://localhost:8000/api (development only).
# Production builds require HTTPS. Configure Laravel CORS and Clerk authorized
# parties for the exact Expo web origin when running in a browser.
EXPO_PUBLIC_API_URL=http://192.168.1.50:8000/api
